# Copy this file to .env and fill in your values.

# MySQL connection string:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
#   XAMPP (root, no password):   mysql://root@localhost:3306/quotepro
#   MySQL 8 installer:           mysql://root:YOUR_PASSWORD@localhost:3306/quotepro
#   Railway / Aiven / cPanel:    paste the connection string they give you
# If the password contains @ : / # ? or %, URL-encode it (e.g. @ becomes %40).
DATABASE_URL="mysql://root:password@localhost:3306/quotepro"

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
JWT_EXPIRES_IN="7d"

PORT=4000

# Frontend address(es) allowed to call the API, comma separated.
CORS_ORIGIN="http://localhost:5173"

# Business time zone, used for "today" (quotation expiry, overdue invoices).
APP_TIMEZONE="Asia/Colombo"

# First admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@quotepro.lk"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_ADMIN_NAME="Admin"
# Also add sample clients and quotations? (true / false)
SEED_SAMPLE_DATA=true
